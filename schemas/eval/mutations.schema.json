{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:renguard:schema:eval:mutations:1.0.0",
  "title": "RenGuard mutation recipe catalog",
  "description": "Structural contract for safe declarative mutation recipes.",
  "type": "object",
  "required": ["mutation_recipes"],
  "properties": {
    "mutation_recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "applicable_to", "description", "preserves_semantics", "safety_notes"],
        "properties": {
          "id": {"type": "string", "pattern": "^RG-MUT-[0-9]{3}$"},
          "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
          "category": {"type": "string", "minLength": 1},
          "applicable_to": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["ATTACK", "BOUNDARY", "CHAIN"]}},
          "description": {"type": "string", "minLength": 1},
          "preserves_semantics": {"const": true},
          "safety_notes": {"type": "string", "minLength": 1},
          "automatic_materialization": {"enum": ["SUPPORTED", "NOT_AUTOMATICALLY_MATERIALIZED"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
